# Backend only. Copy to .env and fill in your key locally.
# Never put this key in React code or a VITE_ variable.
CFBD_API_KEY=

# Configure these on your host; never commit real credentials.
# APP_ORIGIN must be the exact HTTPS site origin in production.
APP_ORIGIN=
RESEND_API_KEY=
EMAIL_FROM=
# DB_PATH is optional locally; production requires a persistent disk path.
# DB_PATH=/var/data/picks-club.sqlite
# NODE_ENV=production
# SERVE_CLIENT=true
# TRUST_PROXY_HOPS=1
# Optional pilot access controls. Keep the actual access code private.
# REGISTRATION_CODE=
# PILOT_ORGANIZER_EMAILS=
# PILOT_POOL_LIMIT=1
