  "main": "index.js",
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file=../.env index.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test selection.test.ts app.test.ts contest.test.ts sms.test.ts database.test.ts",
    "start": "node --import tsx index.ts",
    "backup": "node --env-file-if-exists=../.env --import tsx backup.ts",
    "db:import": "node --env-file-if-exists=../.env --import tsx import-sqlite.ts",
    "db:start": "node --env-file-if-exists=../.env --import tsx local-postgres.ts"
  },
  "keywords": [],
